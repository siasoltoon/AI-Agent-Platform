ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOG_LEVEL=info
MAX_QUEUED_TASKS=100
SHUTDOWN_TIMEOUT_SECONDS=10
WORKER_HOST=192.168.1.3
WORKER_PORT=8001
WORKER_TIMEOUT=900
WORKER_HTTP_TIMEOUT_MARGIN_SECONDS=30
# Remote worker calls the controller's authoritative execution ledger.
EXECUTION_AUTHORITY_URL=http://192.168.1.2:8000
# Optional shared secret; set the same value on controller and worker.
EXECUTION_AUTHORITY_TOKEN=
EXECUTION_AUTHORITY_TIMEOUT=5
LARGE_TASK_TIMEOUT=1800
LARGE_TASK_THRESHOLD=12000
MAX_PLAN_STEPS=12
STEP_CONTEXT_CHARS=12000
MISSION_CONTEXT_CHARS=28000
MISSION_CHUNK_CHARS=16000
DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
# Absolute root under which all worker mission workspaces must live.
WORKER_ISOLATION_ROOT=C:\AI-Agent-Worker
TASK_DB_PATH=data/tasks.db
